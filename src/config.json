        "LD06": {
            "PORT": "/dev/ttyS0",
            "BAUDRATE": 230400,
            "SAMPLING_RATE": 4500,
            "OUT_LEN": 38,
            "OFFSET": 0,
            "PWM_COEFFS": [33.3174, -0.8497]
        },

        "LIDAR_OFFSET_ANGLE": 0.0,
